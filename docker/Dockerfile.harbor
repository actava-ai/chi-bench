# syntax=docker/dockerfile:1.7
# Native Harbor task builds: clean agent, trusted simulator, separate verifier.
FROM python:3.12-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/workspace/.venv \
    PATH="/workspace/.venv/bin:${PATH}" \
    IS_SANDBOX=1

ARG CLAUDE_CODE_VERSION=2.1.219
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git tini \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @anthropic-ai/claude-code@"${CLAUDE_CODE_VERSION}" mcporter \
    && command -v claude \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
RUN pip install --no-cache-dir uv \
    && echo 'export PATH="/workspace/.venv/bin:$PATH"' > /etc/profile.d/chi-bench.sh

FROM base AS application
ARG CHI_BENCH_REF
RUN python -c 'import re,sys; assert re.fullmatch("[0-9a-f]{40}", sys.argv[1]), "CHI_BENCH_REF requires a full immutable commit SHA"' "$CHI_BENCH_REF" \
    && git init /tmp/chi-bench-source \
    && git -C /tmp/chi-bench-source remote add origin https://github.com/actava-ai/chi-bench \
    && git -C /tmp/chi-bench-source fetch --depth 1 origin "${CHI_BENCH_REF}" \
    && git -C /tmp/chi-bench-source checkout --detach FETCH_HEAD \
    && test "$(git -C /tmp/chi-bench-source rev-parse HEAD)" = "$CHI_BENCH_REF" \
    && cp /tmp/chi-bench-source/pyproject.toml /tmp/chi-bench-source/uv.lock /tmp/chi-bench-source/README.md /tmp/chi-bench-source/LICENSE /workspace/ \
    && cp -r /tmp/chi-bench-source/src /workspace/src \
    && cp /tmp/chi-bench-source/docker/entrypoint.sh /usr/local/bin/entrypoint.sh \
    && mkdir -p /opt/chi-bench-compat \
    && cp -r /tmp/chi-bench-source/docker/shims/healthverse /opt/chi-bench-compat/healthverse \
    && chmod +x /usr/local/bin/entrypoint.sh \
    && uv sync --no-dev --extra openai-agents \
    && /workspace/.venv/bin/playwright install --with-deps chromium \
    && pip install --no-cache-dir "huggingface_hub[cli]" \
    && rm -rf /tmp/chi-bench-source

FROM application AS trusted
ARG CHI_BENCH_DATASET_REV
ARG CHI_BENCH_HANDBOOK_REV
ENV CHI_BENCH_HANDBOOK_REV=${CHI_BENCH_HANDBOOK_REV}
RUN python -c 'import re,sys; assert all(re.fullmatch("[0-9a-f]{40}", value) for value in sys.argv[1:]), "Dataset and handbook revisions require full immutable commit SHAs"' "$CHI_BENCH_DATASET_REV" "$CHI_BENCH_HANDBOOK_REV" \
    && hf download actava/chi-bench --repo-type dataset --revision "${CHI_BENCH_DATASET_REV}" --local-dir /tmp/chi-bench-data \
    && mkdir -p /opt/chi-bench/worlds /opt/chi-bench/tasks /opt/chi-bench-task-assets /logs/artifacts/workspaces /workspace/skills \
    && for path in prior_auth_provider/shared/worlds prior_auth_um/shared/worlds care_management/shared/worlds prior_auth_e2e/worlds; do \
         if [ -d "/tmp/chi-bench-data/$path" ]; then cp -r "/tmp/chi-bench-data/$path/." /opt/chi-bench/worlds/; fi; \
       done \
    && for domain in prior_auth_provider prior_auth_um care_management prior_auth_e2e; do \
         if [ -d "/tmp/chi-bench-data/$domain/tasks" ]; then cp -r "/tmp/chi-bench-data/$domain/tasks/." /opt/chi-bench/tasks/; fi; \
       done \
    && cp -r /tmp/chi-bench-data/marathon /opt/chi-bench/tasks/marathon \
    && cp /tmp/chi-bench-data/care_management/shared/tool_reference.md /opt/chi-bench-task-assets/tool_reference.md \
    && ln -s /opt/chi-bench-task-assets /opt/healthverse-task-assets \
    && cp -r /opt/chi-bench-compat/healthverse /workspace/.venv/lib/python3.12/site-packages/healthverse \
    && rm -rf /tmp/chi-bench-data

RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    'HB=/workspace/skills/managed-care-operations-handbook' \
    'if [ ! -d "$HB" ] || [ -z "$(ls -A "$HB")" ]; then' \
    '  TOKEN="${HF_TOKEN:-${HUGGING_FACE_HUB_TOKEN:-}}"' \
    '  if [ -z "$TOKEN" ]; then echo "A handbook artifact or approved HF_TOKEN is required" >&2; exit 78; fi' \
    '  HF_TOKEN="$TOKEN" hf download actava/managed-care-operations-handbook --repo-type dataset --revision "$CHI_BENCH_HANDBOOK_REV" --local-dir /workspace/skills >&2' \
    'fi' \
    > /usr/local/bin/ensure-handbook \
    && chmod +x /usr/local/bin/ensure-handbook

ENV CHI_BENCH_RUNTIME_DIR=/tmp/chi-bench-runtime \
    CHI_BENCH_WORLDS_DIR=/opt/chi-bench/worlds \
    CHI_BENCH_PAYER_MODE=agent \
    CHI_BENCH_WORKSPACE_ROOT=/logs/artifacts/workspaces \
    CHI_BENCH_RAW_ROOT=/srv/chi-bench/raw

FROM trusted AS simulator
RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    '/usr/local/bin/ensure-handbook' \
    'exec /usr/local/bin/entrypoint.sh "$@"' \
    > /usr/local/bin/harbor-entrypoint.sh \
    && chmod +x /usr/local/bin/harbor-entrypoint.sh
EXPOSE 8020 8023 8100 8200
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/harbor-entrypoint.sh"]
CMD ["sleep", "infinity"]

FROM trusted AS verifier
ENTRYPOINT []
CMD ["sleep", "infinity"]

# Clean default target: no trusted source, fixture, or verifier layers.
FROM base AS agent
COPY --from=application /workspace/.venv /workspace/.venv
COPY --from=application /workspace/src/chi_bench/__init__.py /workspace/src/chi_bench/__init__.py
COPY --from=application /workspace/src/chi_bench/experiment/__init__.py /workspace/src/chi_bench/experiment/__init__.py
COPY --from=application /workspace/src/chi_bench/experiment/agents/__init__.py \
    /workspace/src/chi_bench/experiment/agents/openai_agents_runner.py \
    /workspace/src/chi_bench/experiment/agents/openai_agents_local_tools.py \
    /workspace/src/chi_bench/experiment/agents/nemotron_tinker_model.py \
    /workspace/src/chi_bench/experiment/agents/nemotron_tool_protocol.py \
    /workspace/src/chi_bench/experiment/agents/
RUN mkdir -p /agent-assets/skills /agent-assets/tools /agent-raw/artifacts /logs/agent /logs/artifacts \
    && ln -s /agent-assets/skills /workspace/skills \
    && ln -s /agent-assets/tools /opt/chi-bench-task-assets \
    && ln -s /opt/chi-bench-task-assets /opt/healthverse-task-assets \
    && ln -s /agent-raw /workspace/raw
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
